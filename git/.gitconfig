[user]
    # Set your name and email here or in ~/.gitconfig.local
    # name = Your Name
    # email = your@email.com

[core]
    editor = nvim
    excludesFile = ~/.gitignore_global

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default

[alias]
    st = status
    co = checkout
    br = branch
    ci = commit
    lg = log --oneline --graph --decorate
    last = log -1 HEAD
    unstage = reset HEAD --
    amend = commit --amend --no-edit

[include]
    # Local overrides (not tracked in git)
    path = ~/.gitconfig.local
