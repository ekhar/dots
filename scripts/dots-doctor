#!/usr/bin/env bash
# Check that this machine matches the repository: links, commands, syntax, tmux,
# obvious secrets, and uncommitted drift. Exits 1 on any failure.
set -u

DOTS="${DOTS_DIR:-$HOME/dots}"
failures=0
warnings=0

ok() { printf '\033[0;32m[OK]\033[0m %s\n' "$1"; }
warn() { warnings=$((warnings + 1)); printf '\033[0;33m[WARN]\033[0m %s\n' "$1"; }
fail() { failures=$((failures + 1)); printf '\033[0;31m[FAIL]\033[0m %s\n' "$1"; }
have() { command -v "$1" >/dev/null 2>&1; }
section() { printf '\n%s\n' "$1"; }

packages=(zsh tmux git nvim opencode pi)
[[ "$(uname -s)" == Darwin ]] && packages+=(ghostty)

section "Links"
for package in "${packages[@]}"; do
  linked=0
  while IFS= read -r file; do
    target="$HOME/$file"
    if [[ ! -e "$target" && ! -L "$target" ]]; then
      fail "~/$file is missing"
    elif [[ "$(realpath "$target" 2>/dev/null)" != "$DOTS/$package/$file" ]]; then
      warn "~/$file is not linked to $package/$file"
    else
      linked=$((linked + 1))
    fi
  done < <(cd "$DOTS/$package" && git ls-files | grep -v '\.gitignore$')
  ok "$package: $linked files linked"
done
[[ -e "$HOME/.zshrc.local" ]] && [[ "$(stat -c '%a' "$HOME/.zshrc.local" 2>/dev/null || stat -f '%Lp' "$HOME/.zshrc.local")" != 600 ]] &&
  warn "~/.zshrc.local should be mode 600"

section "Commands"
for name in zsh tmux git stow nvim fzf zoxide eza bat rg fd jq direnv fnm starship; do
  if have "$name"; then ok "$name"; else fail "$name is not on PATH"; fi
done

section "Syntax and startup"
parsed=1
for file in "$DOTS"/zsh/.zsh{env,rc} "$DOTS/zsh/.zprofile"; do zsh -n "$file" || parsed=0; done
for file in "$DOTS/install.sh" "$DOTS"/scripts/*; do bash -n "$file" || parsed=0; done
if ((parsed)); then ok "zsh files and scripts parse"; else fail "syntax error"; fi
TIMEFORMAT=%R
seconds=$( { time zsh -ic exit >/dev/null 2>&1; } 2>&1 )
ok "interactive zsh starts in ${seconds}s"
socket="dots-doctor-$$"
if tmux -L "$socket" -f "$HOME/.tmux.conf" new-session -d 2>/dev/null; then
  ok "tmux configuration loads"
  tmux -L "$socket" kill-server 2>/dev/null
else
  fail "tmux configuration failed to load"
fi

section "Secrets"
secrets=$(rg -l --hidden --glob '!.git/**' --glob '!*.example' \
  '(^|[[:space:]'\''"])[A-Z0-9_]*(TOKEN|SECRET|PASSWORD|PRIVATE_KEY|API_KEY)[A-Z0-9_]*=[^[:space:]'\''"]{12,}|(^|[^[:alnum:]_])sk-[A-Za-z0-9_-]{20,}' \
  "$DOTS" 2>/dev/null)
if [[ -z "$secrets" ]]; then ok "no obvious secrets"; else warn "possible secrets in: $secrets"; fi

section "Repository"
drift=$(git -C "$DOTS" status --short)
if [[ -z "$drift" ]]; then
  ok "no uncommitted changes"
else
  # Installers append PATH lines to linked files; this catches them.
  warn "uncommitted changes in $DOTS:"
  printf '%s\n' "$drift"
fi

printf '\n'
if ((failures > 0)); then fail "$failures failure(s), $warnings warning(s)"; exit 1; fi
if ((warnings > 0)); then warn "0 failures, $warnings warning(s)"; else ok "all checks passed"; fi
