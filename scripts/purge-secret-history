#!/usr/bin/env bash
set -euo pipefail

SECRET_PATH="${1:-.config/stripe/config.toml}"
REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

if [[ "${CONFIRM_HISTORY_REWRITE:-}" != "$SECRET_PATH" ]]; then
  cat >&2 <<EOF
This rewrites every local ref and removes $SECRET_PATH from all commits.
Commit or stash all work, remove additional worktrees, and rerun with:

  CONFIRM_HISTORY_REWRITE='$SECRET_PATH' $0 '$SECRET_PATH'
EOF
  exit 2
fi

if [[ -n "$(git status --porcelain)" ]]; then
  echo "Refusing to rewrite history with a dirty working tree." >&2
  exit 1
fi

worktree_count=$(git worktree list --porcelain | grep -c '^worktree ')
if ((worktree_count > 1)); then
  echo "Refusing to rewrite history while multiple worktrees exist." >&2
  exit 1
fi

if ! command -v git-filter-repo >/dev/null 2>&1; then
  echo "git-filter-repo is required (brew install git-filter-repo)." >&2
  exit 1
fi

git filter-repo --sensitive-data-removal --invert-paths --path "$SECRET_PATH" --force

cat <<EOF
History rewritten locally. Verify before publishing:

  git log --all -- '$SECRET_PATH'
  gitleaks git . --log-opts='--all'

Rotate every exposed credential, coordinate with collaborators, restore the
origin remote if git-filter-repo removed it, then force-push all rewritten refs.
EOF
